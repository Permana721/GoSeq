# GoSeq Configuration

# Server Binding
HOST=127.0.0.1
PORT=5000

# Directory to store Logseq Markdown files (auto-created on startup)
JOURNALS_DIR=./journals

# Admin Credentials (verified with subtle.ConstantTimeCompare)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password

# 32+ character random secret used for HMAC-SHA256 session cookie signing
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters

# Set to true if served exclusively over HTTPS
SECURE_COOKIE=false

# Timezone locked to Asia/Jakarta by default
TIMEZONE=Asia/Jakarta
